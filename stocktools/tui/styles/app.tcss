/* ── StockTools TUI Theme ─────────────────────────────── */
/* Uses fully transparent background layers so terminal content shows through. */

Screen {
    background: $background;
    color: $text;
}

/* ── Header hint bar ──────────────────────────────────── */

#hint-bar {
    dock: top;
    height: 1;
    background: $surface;
    color: $text-muted;
    border-bottom: solid $border;
    padding: 0 1;
}

/* ── Tab bar ──────────────────────────────────────────── */

#tab-bar {
    dock: top;
    height: 1;
    background: $surface;
    border-bottom: solid $border;
    padding: 0 1;
}

/* ── Status bar ───────────────────────────────────────── */

#status-bar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
    border-top: solid $border;
    padding: 0 1;
}

/* ── Page-level hints bar (bottom of each tab) ────────── */

.page-hints {
    dock: bottom;
    height: 1;
    background: $background;
    color: $text-muted;
    border-top: solid $border;
    padding: 0 1;
}

/* ── Main content area ────────────────────────────────── */

#content {
    layout: horizontal;
    background: $background;
}

#left-panel {
    width: 1fr;
    min-width: 24;
    max-width: 40;
    border-right: solid $border;
    background: $background;
}

#right-panel {
    width: 3fr;
    padding: 1 2;
    background: $background;
}

/* ── DataTable styling ────────────────────────────────── */

DataTable {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $surface;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $surface;
    color: $text;
}

DataTable > .datatable--hover {
    background: $surface;
}

/* ── Detail panel ─────────────────────────────────────── */

DetailPanel {
    background: $background;
}

VerticalScroll {
    background: $background;
}

/* ── Scanner selector ─────────────────────────────────── */

#scanner-selector {
    height: auto;
    padding: 0 1;
    background: $background;
    border-bottom: solid $border;
}

.scanner-btn {
    margin: 0 1 1 0;
    min-width: 8;
    height: 1;
    background: $background;
    color: $text-muted;
    border: none;
}

.scanner-btn:hover {
    color: $text;
}

.scanner-btn.selected {
    color: $accent;
    text-style: bold underline;
}

/* ── Scan left panel needs more width ─────────────────── */

ScanTab #left-panel {
    max-width: 64;
}

/* ── Input modal ──────────────────────────────────────── */

InputModal {
    align: center middle;
}

#modal-container {
    width: 50;
    max-width: 80%;
    height: auto;
    max-height: 12;
    background: $surface;
    border: round $border;
    padding: 1 2;
}

#modal-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#modal-input {
    width: 100%;
    margin-bottom: 1;
}

#modal-error {
    color: $error;
    text-align: center;
    height: 1;
}

/* ── History modal ────────────────────────────────────── */

HistoryModal {
    align: center middle;
}

#history-container {
    width: 80;
    max-width: 90%;
    height: 24;
    max-height: 80%;
    background: $surface;
    border: round $border;
    padding: 1 2;
}

#history-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

/* ── Tab widgets ──────────────────────────────────────── */

WatchlistTab, HoldingsTab, ScanTab {
    background: $background;
}
