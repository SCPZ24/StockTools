/* ── StockTools TUI Theme ─────────────────────────────── */
/* Every surface is fully transparent so the terminal shows through; only text
   carries color. No borders on the single-row docked bars — a border would
   consume their one content row and hide the text. */

Screen {
    background: transparent;
    color: $text;
}

/* ── Header hint bar ──────────────────────────────────── */

#hint-bar {
    dock: top;
    height: 1;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

/* ── Tab bar ──────────────────────────────────────────── */

#tab-bar {
    dock: top;
    height: 1;
    background: transparent;
    padding: 0 1;
}

/* ── Status bar ───────────────────────────────────────── */

#status-bar {
    dock: bottom;
    height: 1;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

/* ── Page-level hints bar (bottom of each tab) ────────── */

.page-hints {
    dock: bottom;
    height: 1;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

/* ── Main content area ────────────────────────────────── */

#content {
    layout: horizontal;
    background: transparent;
}

#left-panel {
    width: 1fr;
    min-width: 24;
    max-width: 40;
    background: transparent;
}

#right-panel {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: transparent;
}

/* ── DataTable styling ────────────────────────────────── */

DataTable {
    height: 1fr;
    background: transparent;
    /* No vertical scrollbar on the stock lists — arrow keys still scroll. */
    scrollbar-size-vertical: 0;
}

DataTable > .datatable--header {
    background: transparent;
    color: $accent;
    text-style: bold;
}

/* Selected row: keep the background transparent and mark the selection with a
   text style only, so no opaque bar breaks the transparency. */
DataTable > .datatable--cursor {
    background: transparent;
    text-style: bold underline;
}

DataTable > .datatable--hover {
    background: transparent;
}

/* ── Detail panel ─────────────────────────────────────── */

StockInspector {
    layout: horizontal;
    width: 3fr;
    background: transparent;
}

DetailPanel {
    width: 1fr;
    min-width: 42;
    background: transparent;
}

StockInspector.chart-visible DetailPanel {
    width: 42;
    max-width: 52;
}

StockInspector.chart-hidden DetailPanel {
    width: 1fr;
}

KlineChart {
    width: 1fr;
    min-width: 56;
    height: 1fr;
    padding: 1 1;
    background: transparent;
    color: $text;
}

VerticalScroll {
    background: transparent;
}

/* ── Scanner selector ─────────────────────────────────── */

#scanner-selector {
    height: auto;
    padding: 0 1;
    background: transparent;
}

.scanner-btn {
    margin: 0 1 1 0;
    min-width: 8;
    height: 1;
    background: transparent;
    color: $text-muted;
    border: none;
}

.scanner-btn:hover {
    color: $text;
}

.scanner-btn.selected {
    color: $accent;
    text-style: bold underline;
}

/* ── Scan left panel needs more width ─────────────────── */

ScanTab #left-panel {
    max-width: 64;
}

/* ── Input modal ──────────────────────────────────────── */
/* Modals keep a (white) border so the dialog stays delineated over the
   otherwise transparent content behind it. */

InputModal {
    align: center middle;
}

#modal-container {
    width: 50;
    max-width: 80%;
    height: auto;
    max-height: 12;
    background: transparent;
    border: round $border;
    padding: 1 2;
}

#modal-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#modal-input {
    width: 100%;
    margin-bottom: 1;
}

#modal-error {
    color: $error;
    text-align: center;
    height: 1;
}

/* ── History modal ────────────────────────────────────── */

HistoryModal {
    align: center middle;
}

#history-container {
    width: 80;
    max-width: 90%;
    height: 24;
    max-height: 80%;
    background: transparent;
    border: round $border;
    padding: 1 2;
}

#history-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

/* ── Tab widgets ──────────────────────────────────────── */

WatchlistTab, HoldingsTab, ScanTab {
    background: transparent;
}
